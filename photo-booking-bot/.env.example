# Telegram
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_ID=123456789
# Несколько админов через запятую (если задано — ADMIN_ID игнорируется)
# ADMIN_IDS=123456789,987654321

# Закрытый канал (подписка)
# ID закрытого канала (число из t.me/c/XXXX/1, без -100). Бот должен быть админом с правом invite.
# CLOSED_CHANNEL_ID=
# OPENAI_API_KEY=sk-...
# С VPS в РФ OpenAI часто недоступен напрямую — укажите прокси:
# OPENAI_HTTPS_PROXY=http://user:pass@host:port
# (или используется HTTPS_PROXY / TELEGRAM_HTTPS_PROXY из Secrets при деплое)

# Оплата (СБП) — fallback, если не задано в app_settings БД
PHONE=+79817726003
RECIPIENT_NAME=Анна Н.

# Цены задаются в админке /anna (хранятся в SQLite app_settings)

# Путь к SQLite (по умолчанию data/booking.db)
# DATABASE_PATH=data/booking.db

# Если api.telegram.org недоступен с VPS (РФ) — бесплатно через Cloudflare Worker:
# TELEGRAM_BOT_PROXY_URL=https://telegram-bot-proxy.<account>.workers.dev
# TELEGRAM_BOT_PROXY_SECRET=<тот же секрет, что TELEGRAM_RELAY_SECRET для заявок с сайта>
#
# Платный запасной вариант — HTTPS-прокси:
# HTTPS_PROXY=http://user:pass@host:port
